# ============================================================
# Kabadiwala Connect — SIH26229 prototype configuration
# Copy to `.env` for local development. NEVER commit real keys.
# ============================================================

# --- App ---
APP_NAME=Kabadiwala Connect
ENV=development

# Secret used to sign demo session tokens (change in production!)
SECRET_KEY=sih26229-demo-secret-change-me

# --- Backend server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Database ---
# SQLite is used for the local demo. For production, point DATABASE_URL
# at PostgreSQL (e.g. Supabase: postgresql://user:pass@host:5432/db)
DATABASE_URL=sqlite:///./kabadiwala.db

# --- AI services (all optional — the app runs fully offline) ---
# When a key is present the backend attempts the real service and
# falls back to the deterministic demo engine on any failure.
VISION_API_KEY=
VISION_PROVIDER=demo          # demo | external
GEMINI_API_KEY=
OPENAI_API_KEY=
MAPS_API_KEY=

# --- Frontend (build-time, exposed to the browser) ---
# Leave empty to proxy /api through the Vite dev server (default).
VITE_API_BASE_URL=
VITE_DEMO_CITY=Ahmedabad
VITE_DEFAULT_LANG=en
